using Inventory;
using Ordering;

namespace Ordering.Tests;

/// <summary>
/// Written without a test framework package so the fixture restores and compiles offline. Shape,
/// naming, and the project's IsTestProject flag are what RepoLens keys on.
/// </summary>
public sealed class OrderServiceTests
{
    public async Task PlaceOrderReservesStockAndPersists()
    {
        var ledger = new StockLedger();
        ledger.Receive("SKU-1", 5);
        var service = new OrderService(new OrderRepository(), new PricingCalculator(), ledger);

        var order = await service.PlaceOrderAsync("customer-1", [new OrderLine("SKU-1", 2, 10m)]);

        Assert(order is not null);
        Assert(ledger.OnHand("SKU-1") == 3);
    }

    public async Task PlaceOrderRejectsWhenStockIsShort()
    {
        var ledger = new StockLedger();
        var service = new OrderService(new OrderRepository(), new PricingCalculator(), ledger);

        var order = await service.PlaceOrderAsync("customer-1", [new OrderLine("SKU-1", 2, 10m)]);

        Assert(order is null);
    }

    private static void Assert(bool condition)
    {
        if (!condition)
        {
            throw new InvalidOperationException("Assertion failed.");
        }
    }
}
